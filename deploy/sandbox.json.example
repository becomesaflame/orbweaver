{
  "additionalReadonlyPaths": [],
  "additionalReadwritePaths": [],
  "denyRead": ["~/.ssh", "~/.gnupg", "~/.aws"],
  "allowUnixSockets": [
    "/run/systemd/journal/socket",
    "/run/user/1000/systemd/journal/socket",
    "/run/postgresql/.s.PGSQL.5432"
  ],
  "allowGitConfig": false,
  "networkPolicy": {
    "default": "deny",
    "includeDefaults": true,
    "allow": [],
    "deny": []
  }
}
