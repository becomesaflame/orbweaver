ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Optional fallback when ANTHROPIC_API_KEY is unset.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Required. At least 32 bytes; `serve` refuses to start with the default or a
# short value. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ORBWEAVER_JWT_SECRET=
# Set true only for a local, non-networked dev run with the default secret.
ORBWEAVER_DEV_INSECURE=false
# Comma-separated browser origins allowed for cross-origin API calls.
# Empty = same-origin only (the bundled web UI needs nothing here).
ORBWEAVER_CORS_ORIGINS=
ORBWEAVER_MODEL=claude-sonnet-4-6
ORBWEAVER_CLASSIFIER_MODEL=claude-sonnet-4-6
ORBWEAVER_INJECTION_PROBE_MODEL=claude-haiku-4-5
# off | scoped | all. scoped (default) skips in-project Read/Grep/Glob and benign Bash.
ORBWEAVER_INJECTION_PROBE_MODE=scoped
# Optional: extend the defaults, e.g. "$defaults,generated" / "$defaults;\bmytool\b"
# ORBWEAVER_INJECTION_PROBE_SKIP_DIRS=$defaults
# ORBWEAVER_INJECTION_PROBE_BASH_NETWORK=$defaults
# ORBWEAVER_INJECTION_PROBE_PREFILTER=$defaults
# ORBWEAVER_INJECTION_PROBE_BUDGET_S=3
ORBWEAVER_COMPACT_MODEL=claude-haiku-4-5
# Earth Runtime open models (OpenAI-compatible). Key from earthruntime.com.
# OPENROUTER_API_KEY=pk-prov-YOUR_KEY_HERE
# OPENROUTER_BASE_URL=https://api.earthruntime.com/v1
# ORBWEAVER_MODEL=gpt-oss-120b
# Catalog: qwen3.6-35b, qwen3.8-27b, gpt-oss-120b, deepseek-v4-flash-0731
# The same catalog names work on ORBWEAVER_CLASSIFIER_MODEL,
# ORBWEAVER_INJECTION_PROBE_MODEL, and ORBWEAVER_COMPACT_MODEL.
ORBWEAVER_PERMISSION_MODE=auto
ORBWEAVER_SANDBOX=true
ORBWEAVER_SANDBOX_FAIL_IF_UNAVAILABLE=true
ORBWEAVER_SANDBOX_CONFIG=
ORBWEAVER_SANDBOX_UNIX_SOCKETS=
ORBWEAVER_SANDBOX_ALLOWED_DOMAINS=
ORBWEAVER_SANDBOX_INCLUDE_DEFAULT_DOMAINS=true
ORBWEAVER_PINNED_TOKEN_CAP=4000
ORBWEAVER_SKILLS_TOKEN_CAP=4000
DATABASE_URL=postgresql://orbweaver:orbweaver@localhost:5432/orbweaver
ORBWEAVER_STORE=postgres
ORBWEAVER_DATA_DIR=
WORKSPACE_ROOT=.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
ORBWEAVER_IMAGE_API_KEY=
ORBWEAVER_IMAGE_API_URL=https://api.openai.com/v1/images/generations
ORBWEAVER_IMAGE_MODEL=dall-e-3
ORBWEAVER_IMAGE_SIZE=1024x1024
ORBWEAVER_LINTER=
ORBWEAVER_SEARCH_PROVIDER=
ORBWEAVER_BRAVE_API_KEY=
ORBWEAVER_HOST=127.0.0.1
ORBWEAVER_PORT=8080
ORBWEAVER_ALLOW_HTTP_MINT=false
# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
ORBWEAVER_TRUST_PROXY=false
# Long-term facts via Hindsight (empty URL = native chunk memory only).
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=personal
